# Template for .env -- copy to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored because these values are specific to one machine.
# This file is committed so anyone cloning the repo knows what to set.

# Serial port of the ESP32 node, as seen by your laptop.
# macOS / Linux:  ls /dev/tty.usb*      -> e.g. /dev/tty.usbserial-0001
# Windows:        Device Manager        -> e.g. COM3
ESP32_PORT=
