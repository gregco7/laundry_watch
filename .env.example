# Template for .env -- copy to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored because these values are specific to one machine.
# This file is committed so anyone cloning the repo knows what to set.

# Serial port of the ESP32 node, as seen by your laptop.
# macOS:    ls /dev/cu.*          -> e.g. /dev/cu.SLAB_USBtoUART
#                                     or /dev/cu.usbserial-0001
# Linux:    ls /dev/ttyUSB*       -> e.g. /dev/ttyUSB0
# Windows:  Device Manager        -> e.g. COM3
#
# On macOS use /dev/cu.* and never /dev/tty.* -- tty blocks on carrier detect
# and hangs with no error message.
ESP32_PORT=

# LAN address of the node. On the board: wlan.ifconfig()[0]
# Only needed once WebREPL is enabled; after that USB is optional.
ESP32_IP=

# WebREPL password set on the board via `import webrepl_setup`.
# MicroPython caps this at 4-9 characters -- longer ones are silently
# rejected and the prompt just loops.
# This is the node's only access control: WebREPL is plain ws:// over the LAN,
# so treat it as "keeps housemates out", not as real security.
ESP32_WEBREPL_PASSWORD=
