.DS_Store
CLAUDE.md

# Local environment -- machine-specific paths, never committed
.env

#Random Stuff not relevant to others
.HANDOFF.md
tools/autoflash.sh
bullets.md
testing_files/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Local database (SQLite)
*.db
*.sqlite3
# WAL sidecars. They exist because db.py sets journal_mode=WAL, and *.db does
# not match them -- the names end in -wal/-shm, not .db. Note they are not
# disposable while the server is running: uncommitted pages live in the -wal,
# so copying laundry.db on its own can lose the most recent marks.
*.db-wal
*.db-shm
*.db-journal

# Web
node_modules/
web/dist/
web/*.tsbuildinfo

# Raw recordings -- ~3.4 MB per cycle, and the repo would carry every one of
# them forever. They live on the laptop that recorded them; back that up
# yourself, because a wash cannot be re-recorded after the fact.
# analysis/labels/ IS tracked: it is kilobytes, and it is the part a human made.
analysis/recordings/

HANDOFF.md

# Node WiFi credentials
firmware/secrets.py

# MicroPython stubs for the editor. Reinstall with:
#   pip install -U micropython-esp32-stubs --target typings --no-user
#   rm typings/socket.pyi typings/usocket.pyi   # they shadow CPython's socket
#                                               # and break tools/wrepl.py
typings/


# Live prediction logs -- regenerated by the server, ~150 KB per wash
analysis/predictions/

# Generated plots -- regenerate with `label.py --plot`
analysis/plots/
